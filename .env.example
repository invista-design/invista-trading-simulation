# Postgres connection. On Vercel the Neon integration sets these automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional direct connection used only for migrations during the build.
DATABASE_URL_UNPOOLED=

# Code you type on /setup to create the first organiser account. At least 12 characters.
# Keep it private. After setup it has no further use.
SETUP_TOKEN=

# Optional: database connections per server instance (default 5).
DB_POOL_MAX=5
